APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=1200

# --- YouTube Shorts generator ---
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Comma separated absolute paths to bold .ttf fonts (defaults to common Windows/Linux fonts)
SHORTS_FONTS=
SHORTS_STORAGE_PATH=
SHORTS_RENDER_QUEUE=render
SHORTS_PUBLISH_QUEUE=publish
# v1.0.1: every user saves their OWN Google OAuth client on the YouTube page (own project = own quota).
# These two are only read once, by the upgrade migration, to give the first user the client v1.0.0 used.
# The redirect URI every user registers is APP_URL + /youtube/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional CA bundle if PHP reports cURL error 60 (e.g. Git for Windows ships one)
HTTP_CA_BUNDLE=

# Shown on the public privacy policy page (needed for Google verification)
CONTACT_EMAIL=

# --- Multi-user (v1.0.1) ---
# Allow people to create accounts (each gets their own workspace). Off by default.
REGISTRATION_ENABLED=false
# Used by `php artisan db:seed` to create the administrator
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Videos a single user may have waiting to render at once
SHORTS_MAX_PENDING_RENDERS=100
